---
import Layout from "@/layouts/Layout.astro";
import FriendCard from "@/components/FriendCard.astro";
import { FRIENDS } from "@/config";
import Header from "@/components/Header.astro";
import Main from "@/layouts/Main.astro";
import Footer from "@/components/Footer.astro";
import Comments from "@/components/Comments";

export const prerender = true;

const title = "友链";
---

<Layout title={title}>
  <Header />

  <Main pageTitle="友链" pageDesc="这里是我的朋友们">
    <!-- 友链列表 -->
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-2">
      {FRIENDS.map(friend => <FriendCard friend={friend} />)}
    </div>
    
    <!-- 添加友链卡片提示 -->
    <div class="mt-12 p-6 bg-gray-50 dark:bg-gray-800 rounded-xl border border-dashed border-gray-300 dark:border-gray-700">
      <div class="text-center">
        <h3 class="text-xl font-semibold mb-2">想要添加你的友链？</h3>
        <p class="text-gray-600 dark:text-gray-400 mb-4">
          如果你也想出现在这里，请按照以下格式在评论区留言：
        </p>
        <div class="bg-white dark:bg-gray-900 p-4 rounded-lg mb-4 text-left font-mono text-sm">
          <pre class="whitespace-pre-wrap">
站点名称: [你的网站名称]
站点链接: [你的网站链接]
站点描述: [网站描述，30字以内]
头像链接: [头像图片链接]
站点标签: [可选标签，如技术、生活等]</pre>
        </div>
        <!-- <p class="text-sm text-gray-500 dark:text-gray-400">
          我会尽快审核并添加你的友链！
        </p> -->
      </div>
    </div>
    
    <!-- 评论区 -->
    <Comments client:only="react" />
  </Main>
  <Footer />
</Layout>